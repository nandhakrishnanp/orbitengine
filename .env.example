# Auth.js secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# GitHub App credentials: https://github.com/settings/apps -> your app
# (Client ID and Client Secret). Callback URL must be set in the app to
# http://localhost:3001/api/auth/callback/github (dev) and
# https://<your-domain>/api/auth/callback/github (prod).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Postgres connection string (ADR-0011). Local dev:
#   docker run -d --name orbitengine-postgres -e POSTGRES_USER=orbitengine \
#     -e POSTGRES_PASSWORD=orbitengine -e POSTGRES_DB=orbitengine -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgres://orbitengine:orbitengine@localhost:5433/orbitengine

# GitHub App (ADR-0002/0012). The app must be installed on the user's account
# and granted access to the repositories they attach. App ID from the app's
# General page. The private key is generated in the app's settings; either set
# GITHUB_APP_PRIVATE_KEY to the PEM contents or point GITHUB_APP_PRIVATE_KEY_PATH
# at a .pem file (never commit the key).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=